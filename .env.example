# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# Nothing here is secret in the example — never commit your real `.env`.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local dev (Postgres on your machine):
DATABASE_URL="postgresql://postgres@localhost:5432/eic_board?schema=public"
# Production (Neon / Supabase / Vercel Postgres) — use the *pooled* connection
# string, and keep `?sslmode=require`:
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# --- Auth (required) -------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public URL of the site. Optional — the app trusts the host it is served from,
# so this only matters if you need to force a specific canonical URL.
# NEXTAUTH_URL="http://localhost:3000"

# --- File storage (optional) -----------------------------------------------
# If unset, uploads are written to ./.uploads (fine for local dev only —
# Vercel's filesystem is read-only, so set this before deploying).
# Create a Blob store in the Vercel dashboard to get this token.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Email (optional) ------------------------------------------------------
# If unset, emails are printed to the server console instead of being sent.
# Get a key at https://resend.com (free tier: 3,000 emails/month).
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Editorial Board <noreply@yourschool.edu>"

# --- SMS for urgent broadcasts (Twilio) ------------------------------------
# If unset, broadcasts are printed to the server console instead of being sent,
# so you can rehearse the whole flow safely.
#
# From the Twilio console (console.twilio.com):
#   ACCOUNT SID and AUTH TOKEN are both on the dashboard home page.
#   TWILIO_FROM is the phone number you bought, in +country format — or a
#   Messaging Service SID (starts with MG) if you set one up.
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_FROM="+15551234567"

# Needed for delivery receipts: Twilio posts message status back to
# <NEXT_PUBLIC_SITE_URL>/api/sms/status. Must be a public HTTPS address —
# localhost is skipped automatically, so receipts are simply off in development.
NEXT_PUBLIC_SITE_URL="https://board.yourschool.edu"

# Also set the country code, price per message, and sender prefix in
# src/lib/config.ts — they control number formatting and the cost estimate.

# Using a local aggregator instead of Twilio? The generic JSON gateway is still
# available: set SMS_PROVIDER="http" and see src/lib/sms.ts for the
# SMS_HTTP_* options.

# --- Scheduled event reminders ---------------------------------------------
# vercel.json runs /api/cron/reminders once a day. Set this to any long random
# string (openssl rand -hex 32) and Vercel Cron will send it as a bearer token;
# without it the endpoint is reachable only by a signed-in administrator.
# CRON_SECRET="replace-me-with-a-long-random-string"

# How far ahead the job looks, in hours. Default 36, which is right for the
# daily schedule — see the comment in src/lib/reminders.ts. Drop to 24 if you
# move the cron to hourly.
# REMINDER_WINDOW_HOURS="36"

# --- Seeding (optional) ----------------------------------------------------
# Password given to every seeded demo account. Change it, or the seed refuses
# to run when NODE_ENV=production.
SEED_PASSWORD="ChangeMe!2024"
